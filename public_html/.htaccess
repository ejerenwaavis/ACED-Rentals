# ACED Rentals - Namecheap Passenger & Security Configuration
# DO NOT REMOVE OR MODIFY CLOUDLINUX PASSENGER DIRECTIVES WHEN CREATED

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Allow Let's Encrypt / ACME challenge requests to pass through untouched
    RewriteRule ^\.well-known/acme-challenge - [L]
    
    # Force HTTPS (cPanel SSL active)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^(www\.)?acedrentals\.com$ [NC]
    RewriteRule ^ https://acedrentals.com%{REQUEST_URI} [R=301,L]
</IfModule>

# Prevent access to hidden files/directories except .well-known
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} !^/\.well-known
    RewriteRule (^|/)\.(?!well-known) - [F]
</IfModule>
